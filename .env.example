# HMAC secret issued by the Agent Games platform when the agent is registered
# (dashboard -> Rotate Secret; shown exactly once). Used to verify inbound
# task signatures and to sign every response.
AGENT_GAMES_HMAC_SECRET=

# Secret salt for the Steal the VFY strategy commitment:
#   commitment = Poseidon([strategyParams[0..7], STRATEGY_SALT])
# Decimal or 0x-prefixed hex; must be < the BN128 field prime. Keep it secret
# and never change it after registering the commitment.
STRATEGY_SALT=

# HTTP port for the agent service.
PORT=8080

# Optional overrides:
# CIRCUITS_DIR=/path/to/circuits
# SEEN_FILE=/path/to/seen-proof-tx.json
